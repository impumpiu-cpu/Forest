{
  "name": "forest",
  "private": true,
  "type": "module",
  "description": "Тёплый Брод — симуляция поселения: поля, навигация, агенты",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/check-layers.mjs && node tools/atlas-check.mjs 2 && node tools/atlas-save-check.mjs 1 && node tools/map-check.mjs 3 && node tools/seam-check.mjs 16 && node tools/campaign-check.mjs 1 && node tools/check-data.mjs && node tools/logic-check.mjs && node tools/determinism.mjs 2 && node tools/rng-check.mjs 3 && node tools/smoke.mjs 2",
    "smoke": "node tools/smoke.mjs",
    "balance": "node tools/balance.mjs",
    "items": "node tools/items-check.mjs",
    "arena": "node tools/arena.mjs",
    "arena:fair": "node tools/arena.mjs --fair",
    "arena:weapons": "node tools/arena.mjs --part weapons",
    "arena:strength": "node tools/arena.mjs --part strength",
    "balance:standard": "node tools/balance.mjs --seeds 10 --days 30 --vary raids=off,rare,often --set predators=many",
    "determinism": "node tools/determinism.mjs",
    "serve": "node tools/serve.mjs",
    "races": "node tools/races-check.mjs",
    "bestiary": "node tools/bestiary-check.mjs",
    "logic": "node tools/logic-check.mjs",
    "atlas": "node tools/atlas-check.mjs",
    "atlas:save": "node tools/atlas-save-check.mjs",
    "map": "node tools/map-check.mjs",
    "seam": "node tools/seam-check.mjs",
    "campaign": "node tools/campaign-check.mjs",
    "campaign:balance": "node tools/campaign-balance.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
